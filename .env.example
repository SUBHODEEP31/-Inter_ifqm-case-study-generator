# Copy to .env and fill in real values. .env is gitignored.

# Groq Cloud API (free tier; sign up at https://console.groq.com - no card required)
GROQ_API_KEY=your_groq_api_key_here
# Google AI Studio key for Gemini (starts with AIza...); used for bulk enrichment
GEMINI_API_KEY=your_gemini_api_key_here
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Model routing
PRIMARY_MODEL=llama-3.3-70b-versatile   # Groq: reasoning / JSON / narrative / critic
UTILITY_MODEL=llama-3.1-8b-instant      # Groq: fast small tasks / fallback
GEMINI_MODEL=gemini-1.5-flash           # Gemini: bulk reading / contextual enrichment

# Local embedding + rerank + NLI models (downloaded on first use)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
NLI_MODEL=lytang/MiniCheck-DeBERTa-v3-Large

# Paths
CHROMA_DIR=D:\ifqm-case-generator\data\chroma_db
OUTPUT_DIR=D:\ifqm-case-generator\output
LOG_DIR=D:\ifqm-case-generator\logs
