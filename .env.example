# Copy to .env and fill in real values. .env is gitignored.

# Groq Cloud API (free tier; sign up at https://console.groq.com - no card required)
GROQ_API_KEY=your_groq_api_key_here

# Model routing (Groq-hosted)
PRIMARY_MODEL=llama-3.3-70b-versatile   # high-reasoning generation / synthesis
UTILITY_MODEL=llama-3.1-8b-instant      # tagging / enrichment / atomization

# Local embedding + rerank + NLI models (downloaded on first use)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
NLI_MODEL=lytang/MiniCheck-DeBERTa-v3-Large

# Paths
CHROMA_DIR=D:\ifqm-case-generator\data\chroma_db
OUTPUT_DIR=D:\ifqm-case-generator\output
LOG_DIR=D:\ifqm-case-generator\logs
