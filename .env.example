# =====================================================================
# IFQM Enterprise AI Case Synthesis Platform - Environment Configuration
# =====================================================================
# Copy this file to '.env' and populate with your own credentials.
# DO NOT commit '.env' to version control.
# =====================================================================

# ---------------------------------------------------------------------
# LLM Provider API Keys
# ---------------------------------------------------------------------
# Groq Cloud API (Get your key at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API (Get your key at: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI API (Optional, fallback provider: https://console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# NaraRouter API (Optional, enterprise routing gateway: https://bynara.id)
NARAROUTER_API_KEY=your_nararouter_api_key_here
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_MODEL=default

# ---------------------------------------------------------------------
# Model Routing Configuration
# ---------------------------------------------------------------------
# Primary reasoning & narrative engine (Groq Llama 3.3 70B or NaraRouter)
PRIMARY_MODEL=llama-3.3-70b-versatile

# Fast utility & classification engine (Groq Llama 3.1 8B)
UTILITY_MODEL=llama-3.1-8b-instant

# Multimodal extraction & long-context enrichment engine
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# Local Embedding, Reranker & NLI Model Specs (HuggingFace)
# ---------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
NLI_MODEL=lytang/MiniCheck-DeBERTa-v3-Large
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ---------------------------------------------------------------------
# Local Directory Storage Paths
# ---------------------------------------------------------------------
CHROMA_DIR=data/chroma_db
OUTPUT_DIR=output
LOG_DIR=logs
